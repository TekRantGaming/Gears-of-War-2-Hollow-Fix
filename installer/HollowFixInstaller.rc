#include <winres.h>
#include "resource.h"

IDI_APP     ICON    "app.ico"
1           24      "app.manifest"
IDR_XINPUT  RCDATA  "../src/out/xinput1_3.dll"
IDR_DINPUT  RCDATA  "../src/out/dinput8.dll"
IDR_INI     RCDATA  "HollowInputFix.ini"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Gears of War 2: Hollow - Controller & HUD Fix installer"
            VALUE "FileVersion", "1.0"
            VALUE "ProductName", "Hollow Controller & HUD Fix"
            VALUE "ProductVersion", "1.0"
            VALUE "OriginalFilename", "HollowFixInstaller.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
